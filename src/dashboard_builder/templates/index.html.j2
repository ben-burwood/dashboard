<!DOCTYPE html>
<html lang="">

<head>
  <meta charset="UTF-8">
  {% if favicon %}<link rel="icon" href="{{ favicon }}">{% endif %}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <script>
    {% include "_scripts.js.j2" %}
  </script>

  <script src="https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js"></script>

  <title>{{ title or 'Dashboard' }}</title>

  <style>
    /* Light/dark palette (custom properties) — see _theme.css.j2 */
    {% include "_theme.css.j2" %}

    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; }
    :root {
      font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
        "Helvetica Neue", Arial, "Noto Sans", sans-serif;
    }

    /* ---- Page (App.vue) ---- */
    .page {
      min-height: 100vh;
      background: var(--color-page-bg);
      color: var(--color-page-fg);
    }
    .page-title {
      margin: 0;
      font-size: 2.25rem;
      line-height: 2.5rem;
      font-weight: 600;
      text-align: center;
      opacity: 0.6;
      letter-spacing: 0.025em;
      padding: 1rem 0;
    }
    .page-body {
      display: flex;
      justify-content: center;
      padding: 0 1rem;
    }
    .groups {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 2.5rem;
      padding: 2rem 0;
    }

    /* ---- Group (ServiceGroup.vue) ---- */
    .group { margin: 0; }
    .group-title {
      margin: 0 0 0.5rem 0;
      font-size: 1.25rem;
      line-height: 1.75rem;
      letter-spacing: 0.025em;
      opacity: 0.8;
      margin-inline-start: 1rem;
    }
    .cards {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }

    /* ---- Card (Service.vue) ---- */
    .card-link {
      display: block;
      text-decoration: none;
      color: inherit;
      transition: transform 0.15s ease;
    }
    .card-link:hover { transform: scale(1.025); }
    .card {
      display: flex;
      align-items: center;
      gap: 1rem;
      border-radius: 1rem;                 /* rounded-2xl */
      background: var(--color-card-bg);
      opacity: 0.9;
      box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
      padding: 1rem;
      min-width: 260px;
      max-width: 28rem;
    }
    .card-link:hover .card {
      box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ---- Icon tile (ServiceIcon.vue) ---- */
    .icon-tile {
      background: var(--color-icon-bg);
      border-radius: 20%;
      font-size: 2.25rem;                   /* text-4xl sizes the iconify glyph */
      line-height: 2.5rem;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 1rem;
    }

    /* ---- Card body ---- */
    .card-body { flex: 1 1 0%; }
    .card-title {
      margin: 0 0 0.5rem 0;
      font-size: 1.125rem;
      line-height: 1.75rem;
      font-weight: 600;
    }
    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    /* ---- Tag pill (ServiceTag.vue) ---- */
    .badge {
      display: inline-flex;
      align-items: center;
      border-radius: 9999px;
      padding: 0.125rem 0.5rem;
      font-size: 0.75rem;
      line-height: 1rem;
      font-weight: 500;
    }
    .badge-primary   { background: var(--badge-primary-bg);   color: var(--badge-primary-fg); }
    .badge-secondary { background: var(--badge-secondary-bg); color: var(--badge-secondary-fg); }
    .badge-accent    { background: var(--badge-accent-bg);    color: var(--badge-accent-fg); }
    .badge-info      { background: var(--badge-info-bg);      color: var(--badge-info-fg); }
    .badge-success   { background: var(--badge-success-bg);   color: var(--badge-success-fg); }
    .badge-warning   { background: var(--badge-warning-bg);   color: var(--badge-warning-fg); }
    .badge-error     { background: var(--badge-error-bg);     color: var(--badge-error-fg); }
    .badge-neutral   { background: var(--badge-neutral-bg);   color: var(--badge-neutral-fg); }

  </style>
</head>

<body>
  <div class="page">
    {% if title %}<h2 class="page-title">{{ title }}</h2>{% endif %}
    <div class="page-body">
      <div class="groups">
        {% for group in groups %}
        <section class="group">
          {% if group.title %}<h2 class="group-title">{{ group.title }}</h2>{% endif %}
          <div class="cards">
            {% for sv in group.services %}
            <a class="card-link" href="{{ sv.service.link }}">
              <div class="card">
                <div class="icon-tile">
                  <iconify-icon icon="{{ sv.service.icon.name }}" style="color: {{ sv.service.icon.color }}"></iconify-icon>
                </div>
                <div class="card-body">
                  <h3 class="card-title">{{ sv.service.title }}</h3>
                  <span class="tags">
                    {% for tag in sv.tags %}
                    <span class="badge badge-{{ tag.color }}">{{ tag.name }}</span>
                    {% endfor %}
                  </span>
                </div>
              </div>
            </a>
            {% endfor %}
          </div>
        </section>
        {% endfor %}
      </div>
    </div>

    {% include "_theme_switcher.html.j2" %}
  </div>
</body>

</html>
