<!DOCTYPE html>
<html lang="">

<head>
  <meta charset="UTF-8">
  {{if .Favicon}}<link rel="icon" href="{{ .Favicon }}">{{end}}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <script>
    {{template "scripts_js" .}}
  </script>

  <script src="https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js"></script>

  <title>{{if .Title}}{{ .Title }}{{else}}Dashboard{{end}}</title>

  <style>
    /* Light/dark palette (custom properties) — see theme.css.gohtml */
    {{template "theme_css" .}}

    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; }
    :root {
      font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
        "Helvetica Neue", Arial, "Noto Sans", sans-serif;
    }

    /* ---- Page ---- */
    .page {
      min-height: 100vh;
      background: var(--color-page-bg);
      color: var(--color-page-fg);
    }
    .page-title {
      margin: 0;
      font-size: 2.25rem;
      line-height: 2.5rem;
      font-weight: 600;
      text-align: center;
      opacity: 0.6;
      letter-spacing: 0.025em;
      padding: 1rem 0;
    }
    .page-body {
      display: flex;
      justify-content: center;
      padding: 0 1rem;
    }
    .groups {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 2.5rem;
      padding: 2rem 0;
    }

    /* ---- Group ---- */
    .group { margin: 0; }
    .group-title {
      margin: 0 0 0.5rem 0;
      font-size: 1.25rem;
      line-height: 1.75rem;
      letter-spacing: 0.025em;
      opacity: 0.8;
      margin-inline-start: 1rem;
    }
    .cards {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }

    /* ---- Card ---- */
    .card-link {
      display: block;
      text-decoration: none;
      color: inherit;
      transition: transform 0.15s ease;
    }
    .card-link:hover { transform: scale(1.025); }
    .card {
      display: flex;
      align-items: center;
      gap: 1rem;
      border-radius: 1rem;                 /* rounded-2xl */
      background: var(--color-card-bg);
      opacity: 0.9;
      box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
      padding: 1rem;
      min-width: 260px;
      max-width: 28rem;
    }
    .card-link:hover .card {
      box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ---- Icon tile ---- */
    .icon-tile {
      background: var(--color-icon-bg);
      border-radius: 20%;
      font-size: 2.25rem;                   /* text-4xl sizes the iconify glyph */
      line-height: 2.5rem;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 1rem;
    }

    /* ---- Card body ---- */
    .card-body { flex: 1 1 0%; }
    .card-title {
      margin: 0 0 0.5rem 0;
      font-size: 1.125rem;
      line-height: 1.75rem;
      font-weight: 600;
    }
    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    /* ---- Tag pill ---- */
    .badge {
      display: inline-flex;
      align-items: center;
      border-radius: 9999px;
      padding: 0.125rem 0.5rem;
      font-size: 0.75rem;
      line-height: 1rem;
      font-weight: 500;
    }
    .badge-primary   { background: var(--badge-primary-bg);   color: var(--badge-primary-fg); }
    .badge-secondary { background: var(--badge-secondary-bg); color: var(--badge-secondary-fg); }
    .badge-accent    { background: var(--badge-accent-bg);    color: var(--badge-accent-fg); }
    .badge-info      { background: var(--badge-info-bg);      color: var(--badge-info-fg); }
    .badge-success   { background: var(--badge-success-bg);   color: var(--badge-success-fg); }
    .badge-warning   { background: var(--badge-warning-bg);   color: var(--badge-warning-fg); }
    .badge-error     { background: var(--badge-error-bg);     color: var(--badge-error-fg); }
    .badge-neutral   { background: var(--badge-neutral-bg);   color: var(--badge-neutral-fg); }

  </style>
</head>

<body>
  <div class="page">
    {{if .Title}}<h2 class="page-title">{{ .Title }}</h2>{{end}}
    <div class="page-body">
      <div class="groups">
        {{range .Groups}}
        <section class="group">
          {{if .Title}}<h2 class="group-title">{{ .Title }}</h2>{{end}}
          <div class="cards">
            {{range .Services}}
            <a class="card-link" href="{{ .Link }}">
              <div class="card">
                <div class="icon-tile">
                  <iconify-icon icon="{{ .IconName }}" style="color: {{ .IconColor }}"></iconify-icon>
                </div>
                <div class="card-body">
                  <h3 class="card-title">{{ .Title }}</h3>
                  <span class="tags">
                    {{range .Tags}}
                    <span class="badge badge-{{ .Color }}">{{ .Name }}</span>
                    {{end}}
                  </span>
                </div>
              </div>
            </a>
            {{end}}
          </div>
        </section>
        {{end}}
      </div>
    </div>

    {{template "theme_switcher" .}}
  </div>
</body>

</html>
